# انسخ هالملف لـ .env واملأ القيم الحقيقية. ما تعمل commit لملف .env أبدًا.
# ⚠️ القسم "Firebase" مطلوب للإقلاع — السيرفر ما بينقلع بدونه (راجع src/config.js).

PORT=3000

# DeepSeek (https://api-docs.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat = alias مستقر. deepseek-v4-flash أرخص وأسرع لو حابب تجربه صراحة.
DEEPSEEK_MODEL=deepseek-chat
# أسعار لكل مليون توكن — للتقدير التلقائي بتكلفة الإحصائيات فقط (مو فاتورة). حدّثها
# لو تغيّرت تسعيرة DeepSeek أو غيّرت الموديل.
DEEPSEEK_PRICE_IN_PER_M=0.27
DEEPSEEK_PRICE_OUT_PER_M=1.10
# ⚠️ DeepSeek أعلن (2026-08) سياسة تسعير ذروة/انخفاض قادمة (تاريخ التفعيل لسا ما صدر):
# السعر بيصير ضعف بساعات الذروة (بتوقيت بيروت تقريبًا: 4-7ص و9ص-1ظ) — يعني نص ساعات
# الدوام تقريبًا. ما بيحتاج تغيير كود لما تنفعّل (DeepSeek بيطبقها تلقائيًا)، بس خذها
# بعين الاعتبار وقت حساب تكلفة كل عميل/تسعير الاشتراكات.

# كاش ردود بالذاكرة لأسئلة FAQ متكررة الصياغة — يوفر استدعاء DeepSeek بالكامل عند تطابق.
# نطاق آمن ضيق عمدًا (راجع src/services/replyCache.js): بس لزبون أول-تواصل، بدون أداة
# استُخدمت بردّه، بدون تصعيد. مفيد أكتر بعد ما تنفعّل سياسة تسعير الذروة فوق.
REPLY_CACHE_ENABLED=true
REPLY_CACHE_TTL_HOURS=12
REPLY_CACHE_MAX_ENTRIES=500

# بث ردود الودجت (SSE) — أول حرف بيوصال خلال لحظات بدل انتظار الرد كامل.
# أي فشل بينزل تلقائياً للمسار العادي. طفّيه فقط لو صادفت مشكلة مع proxy معيّن.
WIDGET_STREAMING=true

# ===== الرسائل الصوتية على واتساب (تحويل لنص) =====
# أي مزود بواجهة متوافقة مع OpenAI — Groq Whisper هو الموصى به (أرخص وأسرع بكثير):
# أنشئ مفتاح من https://console.groq.com وحدّث .env. بدون مفتاح الخدمة مطفية والويبهوك
# بيرد برسالة مهذبة على أي رسالة صوتية (ما بيكسر شي).
# whisper-large-v3-turbo: $0.04/ساعة صوت — أسرع وأرخص من v3 العادي بفرق جودة مهمل
# للرسائل الصوتية القصيرة. لو حسيت دقة العربي ناقصة، رجّع لـwhisper-large-v3.
TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo
TRANSCRIBE_LANGUAGE=ar

# سقف دقائق الصوت خلال فترة التجربة (باقات Starter/Growth/Pro عندها سقوفها المعرّفة بالكود)
TRIAL_VOICE_MINUTES=5

# ===== قناة Telegram =====
# توكن البوت لكل عميل بيتخزن بـconfig.json تبعو (من لوحة الأدمن)، مش هنا بالبيئة العامة.
# التسجيل تلقائي عند الإقلاع — يتطلب PUBLIC_BASE_URL https.

# WhatsApp Cloud API (Meta for Developers, حساب غير موثّق كافي لأول 250 محادثة/يوم)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
WHATSAPP_GRAPH_VERSION=v21.0

# ===== WhatsApp Embedded Signup + توقيع الويبهوك (Meta for Developers) =====
# ⚠️ META_APP_SECRET صار إلزامي لشغل ويبهوك الاستقبال — السيرفر بيتحقق من توقيع
# X-Hub-Signature-256 على كل رسالة واردة، وبدون السر بيرفض كل الويبهوكات (فشل مغلق).
# لو فاضي كمان، قسم "اربط واتساب" بصفحة onboard.html بيضل مخفي والربط يضل يدوي.
# App ID وConfiguration ID مش سريّين، بس App Secret سري فعليًا — ما تحطه بأي محادثة/نص مشترك.
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# رقم واتساب تبعك إنت (نفس Business Manager)، يُستخدم بس لتنبيهك لما محادثة تنصعّد لإنسان —
# مفيد خصوصًا لعملاء الويب-فقط يلي ما إلهم رقم واتساب مخصص يُرسل منه الإشعار
NOTIFY_WHATSAPP_PHONE_NUMBER_ID=

# قد إيش ساعة يضل البوت واقف عن الرد الآلي بعد ما يصير تصعيد لإنسان بمحادثة معينة
HANDOFF_PAUSE_HOURS=4

# مفتاح قديم مشترك بين كل العملاء — استُبدل بمفاتيح pk_/sk_ خاصة بكل عميل (npm run key -- issue).
# خليه شغال (ALLOW_LEGACY_WIDGET_KEY=true) لحد ما تصدّر مفاتيح لكل عملائك الحاليين وتتأكد
# محدا عم يستخدمه (راقب رسائل "[auth] عميل ... لسا عم يستخدم" بالـ log)، وبعدين طفّيه.
WEB_WIDGET_KEY=change-me-too
ALLOW_LEGACY_WIDGET_KEY=true

# سقف حماية الإساءة لجميع الخطط — سقف رسائل الجلسة الواحدة بالساعة + حد إجمالي رسائل العميل باليوم
SESSION_HOURLY_MSG_MAX=30
CLIENT_DAILY_MSG_MAX=500

# ===== التسجيل الذاتي (شركة بتسجّل حالها بنفسها: رابط موقع/PDF → مفتاح API) =====
# الهوية صارت عبر Firebase Auth تحت (الحساب أول، بعدين إعداد البوت) — ما في SMTP ولا
# تحقق إيميل يدوي بهالسيرفر. فعّله بعد ما تجهّز Firebase.
SIGNUP_ENABLED=false
# رابط سيرفرك العام — بيروح بكود الودجت الجاهز وإشعارات المشغّل
PUBLIC_BASE_URL=http://localhost:3000
# مدة الفترة التجريبية بالأيام + سقف رسائل الشات خلالها (يحدّ كلفة أي بوت مهجور تلقائياً)
TRIAL_DAYS=7
TRIAL_MESSAGE_CAP=120
# رقم واتساب تبعك الشخصي — بيوصلك إشعار عند كل تسجيل ذاتي جديد ينفعّل
OPERATOR_WHATSAPP=

# ===== لوحة تحكم المشغّل (/admin) — داخلية، لصاحب المشروع بس =====
# لازم تعبّيها — لو فاضية، /admin بيرفض كل تسجيل دخول (فشل آمن). اختار كلمة سر قوية وعشوائية.
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_HOURS=12

# ===== نسخ احتياطي دوري لـGoogle Sheets (اختياري) =====
# fork عملية منفصلة كل فترة ترفع محتوى data/ لـSheet. يحتاج ملف حساب خدمة Google
# منفصل (أو نفسه FIREBASE credentials لو أعطيته صلاحية تعديل الـSheet).
BACKUP_SHEETS_ENABLED=false
BACKUP_SHEETS_INTERVAL_MINUTES=30
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_SHEETS_SPREADSHEET_ID=

# ===== Firebase — مطلوب للإقلاع (حسابات المستخدمين، طلبات التسجيل، عدادات الاستخدام) =====
# credentialsPath = ملف JSON لحساب خدمة Firebase Admin بصلاحية Firestore + Authentication.
# نفس الملف ممكن يستخدمه النسخ الاحتياطي لـSheets فوق لو أعطيته الصلاحيات المناسبة.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# مدة جلسة حساب المستخدم (بالساعات) — افتراضي 336 (=14 يوم)
USER_SESSION_TTL_HOURS=336
