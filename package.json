{
  "name": "ai-chat-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant AI customer-service bot: WhatsApp Cloud API + website widget, powered by DeepSeek.",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "ingest": "node scripts/ingest.js",
    "key": "node scripts/manage-keys.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/public/tailwind.input.css -o src/public/tailwind.css --minify",
    "backup:sheets": "node scripts/backup-to-sheets.js",
    "purge:deleted-bots": "node scripts/purge-deleted-bots.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:smoke": "node scripts/smoke-test.js",
    "test:voice": "node scripts/test-voice.js",
    "test:campaign": "node scripts/campaign-smoke-test.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "firebase-admin": "^14.2.0",
    "googleapis": "^144.0.0",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "nodemon": "^3.1.7",
    "tailwindcss": "^3.4.19"
  }
}
